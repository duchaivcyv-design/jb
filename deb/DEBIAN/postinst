#!/bin/sh

# Tự động nhận diện môi trường (Rootful vs Rootless)
if [ -d "/var/jb" ]; then
    JBROOT="/var/jb"
    # Trên Rootless, setuid root bị chặn, phải dùng quyền của user mobile (501:501)
    OWNER="501:501"
else
    JBROOT=""
    OWNER="root:wheel"
fi

APP_PATH="${JBROOT}/Applications/ClaudeMini.app"

# Cấp quyền thực thi cho app chính
chmod 755 "${APP_PATH}/ClaudeMini" 2>/dev/null

# Cấp quyền cho icon helper (setuid)
chown ${OWNER} "${APP_PATH}/claudemini-icon" 2>/dev/null
chmod 4755 "${APP_PATH}/claudemini-icon" 2>/dev/null

# Cập nhật icon (tự động tìm uicache ở cả 2 môi trường)
if [ -x "${JBROOT}/usr/bin/uicache" ]; then
    "${JBROOT}/usr/bin/uicache" >/dev/null 2>&1 || true
else
    uicache >/dev/null 2>&1 || true
fi

# Tự động mở lại app nếu vừa cập nhật từ trong app
MARK=/var/mobile/Library/Caches/ClaudeMiniUpdate/relaunch
if [ -f "$MARK" ]; then
  if [ -n "$(find "$MARK" -mmin -30 2>/dev/null)" ]; then
    (
      sleep 3
      # Dùng launchctl asuser 501 để gọi uiopen dưới quyền user, fix lỗi không mở được app trên JB mới
      if [ -x "${JBROOT}/usr/bin/uiopen" ]; then
        launchctl asuser 501 "${JBROOT}/usr/bin/uiopen" --bundleid com.puc.claudemini
      elif [ -x "${JBROOT}/usr/bin/open" ]; then
        launchctl asuser 501 "${JBROOT}/usr/bin/open" com.puc.claudemini
      fi
    ) </dev/null >/dev/null 2>&1 &
  fi
  rm -f "$MARK" 2>/dev/null
fi

exit 0
