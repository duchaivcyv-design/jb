#!/bin/sh

# Tự động nhận diện môi trường (Rootful vs Rootless/RootHide)
if [ -d "/var/jb" ]; then
    JBROOT="/var/jb"
else
    JBROOT=""
fi

case "$1" in
  remove|purge) 
    # Tìm và chạy uicache với đường dẫn chính xác
    if [ -x "${JBROOT}/usr/bin/uicache" ]; then
        "${JBROOT}/usr/bin/uicache" >/dev/null 2>&1 || true
    else
        uicache >/dev/null 2>&1 || true
    fi
    ;;
esac
exit 0
